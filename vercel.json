{
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/generate-image.js": {
      "maxDuration": 60
    },
    "api/process-pdf.js": {
      "maxDuration": 300
    },
    "api/extract-text.js": {
      "maxDuration": 60
    },
    "api/get-pilot-users.js": {
      "maxDuration": 60
    },
    "api/cron-check-expiry.js": {
      "maxDuration": 60
    },
    "api/procesar-tramite.js": {
      "maxDuration": 60
    },
    "api/transcribir-audio.js": {
      "maxDuration": 120
    },
    "api/extraer-texto-pdf.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-check-expiry",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}